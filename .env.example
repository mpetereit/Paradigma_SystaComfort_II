# IP-Adresse der SystaComfort II im LAN (Pflicht)
SYSTA_HOST=<IP-DER-SYSTACOMFORT>
SYSTA_PORT=7260
# UDP-Passwort der Systa (Werkseinstellung 1234, siehe SystaService)
SYSTA_PASS=1234
KEEPALIVE_SECONDS=30

# MQTT-Broker (leer = Werte nur im Log ausgeben)
MQTT_HOST=<IP-DES-MQTT-BROKERS>
MQTT_USER=
MQTT_PASS=
MQTT_BASE_TOPIC=systa

# Optional: Korrelations-Log (Rohframes + Werte eines anderen MQTT-Topics),
# leer = aus. Siehe tools/correlate.py
RAW_LOG_FILE=
CORRELATE_TOPIC=
